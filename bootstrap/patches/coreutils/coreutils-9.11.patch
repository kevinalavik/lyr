 #  define endmntent(fp) fclose (fp)
 # endif
+# ifdef __lyr__
+static FILE *
+lyr_setmntent (const char *mount_file, const char *mode)
+{
+  return fopen (mount_file, mode);
+}
+
+static int
+lyr_endmntent (FILE *fp)
+{
+  if (fp)
+    fclose (fp);
+  return 1;
+}
+
+static struct mntent *
+lyr_getmntent (FILE *fp)
+{
+  static struct mntent m;
+  static char line[1024];
+  char *cp;
+
+  while (fgets (line, sizeof (line), fp) != NULL)
+    {
+      if (line[0] == '#' || line[0] == '\n')
+        continue;
+
+      cp = strchr (line, ' ');
+      if (!cp)
+        continue;
+      *cp++ = '\0';
+
+      m.mnt_fsname = line;
+
+      while (*cp == ' ')
+        cp++;
+      cp = strchr (cp, ' ');
+      if (!cp)
+        continue;
+      *cp++ = '\0';
+
+      m.mnt_dir = cp;
+
+      cp = strchr (cp, ' ');
+      if (!cp)
+        continue;
+      *cp++ = '\0';
+
+      m.mnt_type = cp;
+
+      while (*cp && *cp != ' ')
+        cp++;
+      if (*cp)
+        *cp++ = '\0';
+
+      m.mnt_opts = cp;
+
+      return &m;
+    }
+  return NULL;
+}
+
+#  define setmntent lyr_setmntent
+#  define endmntent lyr_endmntent
+#  define getmntent lyr_getmntent
+#  define MOUNTED "/proc/mounts"
+# endif
 #endif
 
