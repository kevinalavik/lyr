--- src/net/socket.c	2026-05-07 05:01:09.000000000 +0000
+++ src/net/socket.c	2026-05-07 06:55:39.342179966 +0000
@@ -351,17 +386,34 @@
 	if (!dev || !dev->ipv4_addr)
 		return NET_SOCK_ERR_NETUNREACH;
 
+	uint32_t wire_dst_ip = dst_ip;
+	if (dst_port == 53) {
+		uint32_t qemu_dns = qemu_user_dns_proxy_for(dev);
+		if (qemu_dns && dst_ip != qemu_dns) {
+			log_debug("socket",
+					  "UDP DNS redirect %u.%u.%u.%u:53 -> %u.%u.%u.%u:53",
+					  (dst_ip >> 24) & 0xff, (dst_ip >> 16) & 0xff,
+					  (dst_ip >> 8) & 0xff, dst_ip & 0xff,
+					  (qemu_dns >> 24) & 0xff, (qemu_dns >> 16) & 0xff,
+					  (qemu_dns >> 8) & 0xff, qemu_dns & 0xff);
+			wire_dst_ip = qemu_dns;
+			dev = net_route(wire_dst_ip, &next_hop);
+			if (!dev || !dev->ipv4_addr)
+				return NET_SOCK_ERR_NETUNREACH;
+		}
+	}
+
 	uint8_t mac[NET_ETH_ALEN];
 	memset(mac, 0, sizeof(mac));
-	if (!dev->loopback && dst_ip != dev->ipv4_addr) {
-		r = net_arp_resolve(dev, next_hop ? next_hop : dst_ip, 1000, mac);
+	if (!dev->loopback && wire_dst_ip != dev->ipv4_addr) {
+		r = net_arp_resolve(dev, next_hop ? next_hop : wire_dst_ip, 1000, mac);
 		if (r != VFS_OK)
 			return NET_SOCK_ERR_NETUNREACH;
 	}
 
 	uint32_t src_ip = sock->inet_data->local_ip ? sock->inet_data->local_ip :
 		dev->ipv4_addr;
-	r = net_send_ipv4_udp(dev, mac, src_ip, dst_ip,
+	r = net_send_ipv4_udp(dev, mac, src_ip, wire_dst_ip,
 						 sock->inet_data->local_port, dst_port, buf, len);
 	if (r != VFS_OK)
 		return r;
@@ -1163,9 +1215,13 @@
 		if (is->local_ip != 0 && is->local_ip != dst_ip)
 			continue;
 
-		if ((sock->flags & NET_SOCK_CONNECTED) &&
-			(is->remote_ip != src_ip || is->remote_port != src_port))
-			continue;
+		if (sock->flags & NET_SOCK_CONNECTED) {
+			if (is->remote_ip != src_ip || is->remote_port != src_port) {
+				if (!udp_dns_reply_matches(dev, is->remote_ip, src_ip,
+									   is->remote_port, src_port))
+					continue;
+			}
+		}
 
 		if (payload_len > sizeof(is->rx_buf))
 			payload_len = sizeof(is->rx_buf);
